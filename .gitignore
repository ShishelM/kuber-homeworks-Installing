# Игнорируем локальную директорию инициализации Terraform
.terraform/

# Игнорируем lock-файл провайдеров (опционально, но часто добавляют в ignore)
.terraform.lock.hcl

# Игнорируем файлы секретов и состояний инфраструктуры (содержат sensitive данные)
*.tfstate
*.tfstate.*

# Игнорируем логи ошибок
crash.log
crash.*.log
*.log

# Игнорируем файлы переменных, если будешь создавать локальные *.tfvars
*.tfvars
*.tfvars.json

# Игнорируем сторонний склонированный репозиторий Kubespray
# Весь код кубеспрея коммитить в свой репозиторий не нужно, только твои манифесты
kubespray/
